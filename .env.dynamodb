# DynamoDB Environment Configuration
# Use this configuration for DynamoDB + S3 deployment

# Database Configuration (DynamoDB)
DATABASE_URL=dynamodb://us-east-1
DATABASE_TYPE=dynamodb
AWS_REGION=us-east-1

# JWT Configuration
SECRET_KEY=development_secret_key_change_in_production_please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=VitaCheckLabs API
APP_VERSION=1.0.0

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS Configuration (allowing localhost for development)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:3000", "http://127.0.0.1:8080"]

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=["pdf", "jpg", "jpeg", "png"]

# S3 Configuration
S3_BUCKET_NAME=vitachecklabs-reports-poc-v2
S3_REPORTS_PREFIX=lab-reports/
S3_REGION=us-east-1

# DynamoDB Table Names
DYNAMODB_USERS_TABLE=vitachecklabs-users
DYNAMODB_LAB_TESTS_TABLE=vitachecklabs-lab-tests
DYNAMODB_REPORTS_TABLE=vitachecklabs-reports
DYNAMODB_BOOKINGS_TABLE=vitachecklabs-bookings

# Logging Configuration
LOG_LEVEL=DEBUG

# AWS Configuration will be loaded from:
# 1. Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
# 2. AWS credentials file (~/.aws/credentials)
# 3. IAM roles (for ECS/EC2 deployment)