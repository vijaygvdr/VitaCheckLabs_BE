{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DenyPublicAccess",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::vitachecklabs-reports-poc",
                "arn:aws:s3:::vitachecklabs-reports-poc/*"
            ],
            "Condition": {
                "StringNotEquals": {
                    "aws:PrincipalServiceName": [
                        "ec2.amazonaws.com",
                        "ecs-tasks.amazonaws.com"
                    ]
                },
                "Bool": {
                    "aws:PrincipalIsAWSService": "false"
                }
            }
        },
        {
            "Sid": "AllowApplicationAccess",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::430118843240:root"
            },
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::vitachecklabs-reports-poc",
                "arn:aws:s3:::vitachecklabs-reports-poc/*"
            ]
        }
    ]
}