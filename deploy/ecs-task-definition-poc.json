{
  "family": "vitachecklabs-api-poc",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::{ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::{ACCOUNT_ID}:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "vitachecklabs-api-poc",
      "image": "{ECR_REPOSITORY_URI}:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "dynamodb://us-east-1"
        },
        {
          "name": "DATABASE_TYPE",
          "value": "dynamodb"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "S3_BUCKET_NAME",
          "value": "vitachecklabs-reports-poc-v2"
        },
        {
          "name": "S3_REGION",
          "value": "us-east-1"
        },
        {
          "name": "S3_REPORTS_PREFIX",
          "value": "lab-reports/"
        },
        {
          "name": "ENVIRONMENT",
          "value": "poc"
        },
        {
          "name": "DEBUG",
          "value": "false"
        },
        {
          "name": "API_V1_STR",
          "value": "/api/v1"
        },
        {
          "name": "PROJECT_NAME",
          "value": "VitaCheckLabs API POC"
        },
        {
          "name": "APP_VERSION",
          "value": "1.0.0"
        },
        {
          "name": "BACKEND_CORS_ORIGINS",
          "value": "*"
        },
        {
          "name": "DYNAMODB_USERS_TABLE",
          "value": "vitachecklabs-users"
        },
        {
          "name": "DYNAMODB_LAB_TESTS_TABLE",
          "value": "vitachecklabs-lab-tests"
        },
        {
          "name": "DYNAMODB_REPORTS_TABLE",
          "value": "vitachecklabs-reports"
        },
        {
          "name": "DYNAMODB_BOOKINGS_TABLE",
          "value": "vitachecklabs-bookings"
        },
        {
          "name": "DYNAMODB_REPORT_EXPLANATIONS_TABLE",
          "value": "vitachecklabs-report-explanations"
        },
        {
          "name": "DYNAMODB_AI_RULES_TABLE",
          "value": "vitachecklabs-ai-rules"
        },
        {
          "name": "DYNAMODB_AGENT_AUDIT_TABLE",
          "value": "vitachecklabs-agent-audit"
        },
        {
          "name": "DYNAMODB_REMINDERS_TABLE",
          "value": "vitachecklabs-reminders"
        },
        {
          "name": "ALGORITHM",
          "value": "HS256"
        },
        {
          "name": "ACCESS_TOKEN_EXPIRE_MINUTES",
          "value": "30"
        },
        {
          "name": "REFRESH_TOKEN_EXPIRE_DAYS",
          "value": "7"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        }
      ],
      "secrets": [
        {
          "name": "SECRET_KEY",
          "valueFrom": "/vitachecklabs/jwt/secret-key"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "/vitachecklabs/openai/api-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vitachecklabs-api-poc",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/health || exit 1"
        ],
        "interval": 60,
        "timeout": 10,
        "retries": 2,
        "startPeriod": 30
      }
    }
  ]
}